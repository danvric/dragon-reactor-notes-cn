MODULE MAC: GEO: SYBILT: ASM: FLU: EDI: END: ;
LINKED_LIST MACRO ANGEO TRACK SYS FLUX EDT ;

MACRO := MAC: ::
NGRO 2 NMIX 2 NIFI 1
READ INPUT
MIX 1
TOTAL 0.30 0.80
SCAT
1 1 0.25
1 2 0.03
2 2 0.65
2 1 0.01
NUSIGF
0.005 0.10
CHI
1.0 0.0
MIX 2
TOTAL 0.25 1.00
SCAT
1 2 0.04 0.20
2 2 0.95 0.02
;

ANGEO := GEO: ::
TUBE 2
R+ REFL
RADIUS 0.0 0.4 1.0
MIX
1
2
;

TRACK := SYBILT: ANGEO ::
TITLE 'HAHAHAHA'
EDIT 1 MAXR 2 QUA1 5
;

SYS := ASM: MACRO TRACK ::
PIJ
;

FLUX := FLU: SYS MACRO TRACK ::
TYPE K
;

EDT := EDI: MACRO TRACK FLUX ::
EDIT 3 MERG MIX 1 2 COND 2 SAVE
;

END: ;