MODULE LIB: GEO: EXCELT: SHI: ASM: FLU: EDI: END: ;
LINKED_LIST LIBRARY CANDU TRACK PIJ FLUX EDT ;
SEQ_BINARY TRKFIL ;

LIBRARY := LIB: ::
    NMIX 4 CTRA WIMS
    MIXS LIB: DRAGON FIL: /root/dlib99
    MIX 1 900.0
        U235 = U235 7.39E-4 1
        U238 = U238 2.17E-2 1
        O16  = O16  4.49E-2
    MIX 2 600.0
        Zr91 = Zr91 4.3E-2 1
    MIX 3 600.0
        H1   = H1   4.7E-2
        O16  = O16  2.3E-2
    MIX 4 600.0
        H1   = H1   4.7E-2
        O16  = O16  2.3E-2
    ;

CANDU := GEO: ::
    CARCEL 8
    X+ REFL X- REFL
    Y+ REFL Y- REFL
    MESHX -14.2875 14.2875
    MESHY -14.2875 14.2875
    RADIUS 0.0 0.744 2.18125 3.6025 5.1689 5.6032 6.4478 6.5875 14.0
    MIX    1  1    1       1      2      3      4      4      4
    CLUSTER ROD1 ROD2 ROD3 ROD4
:::
ROD1 := GEO: TUBE 2
    MIX 1 2
    RADIUS 0.0 0.6122 0.6540
    NPIN 1 RPIN 0.0 APIN 0.0 ;
:::
ROD2 := GEO: ROD1
    MIX 1 2
    NPIN 6 RPIN 1.4885 APIN 0.0 ;
:::
ROD3 := GEO: ROD1
    MIX 1 2
    NPIN 12 RPIN 2.8755 APIN 0.261799 ;
:::
ROD4 := GEO: ROD1
    MIX 1 2
    NPIN 18 RPIN 4.3305 APIN 0.0 ;
;

TRACK TRKFIL := EXCELT: CANDU ::
    TITLE 'CANDU Cell'
    EDIT 1 MAXR 200
    ALLG BATCH 100
    TRAK TISO 7 20.0 ;

LIBRARY := SHI: LIBRARY TRACK TRKFIL ::
    EDIT 0 NOLJ ;

PIJ := ASM: LIBRARY TRACK TRKFIL :: PIJ ;
FLUX := FLU: PIJ LIBRARY TRACK TRKFIL :: TYPE K ;

EDT := EDI: LIBRARY TRACK FLUX ::
    EDIT 3
    MERG COMP
    COND 2.0
    SAVE ;

END: ;