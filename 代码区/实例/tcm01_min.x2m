* tcm01_min.x2m
* DRAGON minimal example: 1D annular cell, macroscopic XS, K calculation

LINKED_LIST
MACRO ANGEO TRACK SYS FLUX EDITION ;

MODULE
GEO: SYBILT: MAC: ASM: FLU: EDI: DELETE: END: ;

* -------------------------------------------------
* 1) 宏观截面：直接输入
* -------------------------------------------------
MACRO := MAC: ::
NGRO 2 NMIX 2 NIFI 1
READ INPUT
MIX 1
TOTAL 0.222222 0.833333
SCAT
1 1
0.19222
2 2 0.75333 0.02
NUSIGF
0.0
0.135 CHI 1.0 0.0
MIX 2
TOTAL 0.166667 1.111111
SCAT
2 2
0.00015 0.126667 2 2 1.10111 0.04
;

* -------------------------------------------------
* 2) 几何：1D 圆柱，2 个径向区
* -------------------------------------------------
ANGEO := GEO: ::
TUBE 2
R+ REFL
RADIUS 0.0 0.19653 1.0
MIX
1
2
SPLITR
1
4
;

* -------------------------------------------------
* 3) 跟踪：SYBILT，适合 1D / 简单 2D
* -------------------------------------------------
TRACK := SYBILT: ANGEO ::
TITLE 'TCM01 minimal'
EDIT 1 MAXR 5 QUA1 5 ;

* -------------------------------------------------
* 4) ASM：生成碰撞概率/响应矩阵
* -------------------------------------------------
SYS := ASM: MACRO TRACK ;

* -------------------------------------------------
* 5) FLU：解通量，TYPE K 求 Keff
* -------------------------------------------------
FLUX := FLU: SYS MACRO TRACK ::
TYPE K ;

* -------------------------------------------------
* 6) EDI：编辑/均匀化/凝聚，SAVE 保存
* -------------------------------------------------
EDITION := EDI: MACRO TRACK FLUX ::
EDIT 3 SAVE ;

* -------------------------------------------------
* 7) 清理和结束
* -------------------------------------------------
FLUX SYS TRACK := DELETE: FLUX SYS TRACK ;
END: ;