MODULE LIB: GEO: EXCELT: SHI: ASM: FLU: EDI: END: ;
LINKED_LIST LIBRARY CANDU TRACK SYS FLUX EDT ;

LIBRARY := LIB: ::
    NMIX 3 CTRA WIMS
    MIXS LIB: WIMSD4 FIL: iaea
    MIX 1 600.0
        O16  = '6016' 4.61309E-2
        U235 = '2235' 1.66078E-4 1
        U238 = '8238' 2.28994E-2 1
    MIX 2 600.0
        Zr91 = '91'   3.83243E-2
    MIX 3 600.0
        D2O  = '3002' 4.5E-2
        O16  = '6016' 2.2E-2
    ;

CANDU := GEO: ::
    TUBE 3
    R+ REFL
    RADIUS  0.0  5.0  5.5  15.0
    MIX     1    2    3
    CLUSTER ROD1 ROD2 ;
:::
ROD1 := GEO: TUBE 2
    MIX 1 2 RADIUS 0.0 0.6 0.7 NPIN 1 RPIN 0.0 APIN 0.0 ;
:::
ROD2 := GEO: ROD1
    NPIN 6 RPIN 2.0 APIN 0.0 ;
;

TRACK := EXCELT: CANDU ::
    TITLE 'CANDU Cell'
    MAXR 200
    TRAK TISO 12 20.0 ;

LIBRARY := SHI: LIBRARY TRACK ::
    EDIT 0 NOLJ ;

SYS := ASM: LIBRARY TRACK :: PIJ ;
FLUX := FLU: SYS LIBRARY TRACK :: TYPE K ;

EDT := EDI: LIBRARY TRACK FLUX ::
    EDIT 3 MERG COMP COND 4.0 SAVE ;

END: ;