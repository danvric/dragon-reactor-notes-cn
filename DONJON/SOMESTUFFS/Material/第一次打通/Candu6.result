* CLE-2000 VERS 3.0 * R.ROY, EPM COPYRIGHT 1999 *                                                                          LINE
PROCEDURE assertS SetModel SetReflPro SetDevPro                                                                            0001
SetFuelMap SetBurnup SetDevice SetDetect ;                                                                                 0002
LINKED_LIST GEOM MATEX TRACK DEVICE MACRO FMAP NEWFLUX                                                                     0003
MACROFUEL MACROFUEL2 MACRO3 SYSTEM FLUX POWER DETECT ;                                                                     0004
MODULE DSET: CRE: MACINI: TRIVAT: TRIVAA: NEWMAC: DETECT:                                                                  0005
FLUD: FLPOW: TINST: DELETE: GREP: END:   ;                                                                                 0006
REAL Keff ;                                                                                                                0007
INTEGER MaxR := 30000 ;                                                                                                    0008
GEOM MATEX := SetModel :: <<MaxR>> ;                                                                                       0009
TRACK := TRIVAT: GEOM :: MAXR <<MaxR>> MCFD 1 ;                                                                            0010
DEVICE MATEX := SetDevice MATEX ;                                                                                          0011
DEVICE := DSET: DEVICE ::                                                                                                  0012
EDIT 0                                                                                                                     0013
LZC 1 LEVEL .5026 TIME 60. END                                                                                             0014
LZC 2 LEVEL .5400 TIME 36. END                                                                                             0015
LZC 3 LEVEL .3853 TIME 36. END                                                                                             0016
LZC 4 LEVEL .3442 TIME 36. END                                                                                             0017
LZC 5 LEVEL .4485 TIME 36. END                                                                                             0018
LZC 6 LEVEL .5590 TIME 60. END                                                                                             0019
LZC 7 LEVEL .3803 TIME 36. END                                                                                             0020
LZC 8 LEVEL .4354 TIME 60. END                                                                                             0021
LZC 9 LEVEL .5313 TIME 36. END                                                                                             0022
LZC 10 LEVEL .5642 TIME 36. END                                                                                            0023
LZC 11 LEVEL .4256 TIME 36. END                                                                                            0024
LZC 12 LEVEL .4427 TIME 36. END                                                                                            0025
LZC 13 LEVEL .5752 TIME 60. END                                                                                            0026
LZC 14 LEVEL .5126 TIME 36. END                                                                                            0027
;                                                                                                                          0028
DETECT := SetDetect ;                                                                                                      0029
FMAP MATEX := SetFuelMap MATEX ;                                                                                           0030
FMAP := SetBurnup FMAP ;                                                                                                   0031
FMAP := TINST: FMAP  ::                                                                                                    0032
EDIT 0                                                                                                                     0033
TIME 1.0 DAY                                                                                                               0034
REFUEL CHAN M02  8                                                                                                         0035
REFUEL CHAN D15  8                                                                                                         0036
REFUEL CHAN Q12  8                                                                                                         0037
REFUEL CHAN H06  8                                                                                                         0038
TIME 2.4  DAY  ;                                                                                                           0039
LINKED_LIST CPOREFL ;                                                                                                      0040
SEQ_ASCII CELNAT REFL ;                                                                                                    0041
CPOREFL := REFL ;                                                                                                          0042
MACRO := SetReflPro CPOREFL ;                                                                                              0043
LINKED_LIST GT ADJ ZCR STRUC ;                                                                                             0044
SEQ_ASCII GTUBEB RODB ZCPOB MATSTRB ;                                                                                      0045
GT := GTUBEB  ;                                                                                                            0046
STRUC := MATSTRB ;                                                                                                         0047
ZCR := ZCPOB   ;                                                                                                           0048
ADJ := RODB   ;                                                                                                            0049
MACRO := SetDevPro MACRO GT ADJ ZCR STRUC ;                                                                                0050
LINKED_LIST CPOFUEL ;                                                                                                      0051
SEQ_ASCII CELNAT ;                                                                                                         0052
CPOFUEL := CELNAT ;                                                                                                        0053
MACROFUEL := CRE: CPOFUEL FMAP :: EDIT 0 READ                                                                              0054
TABLE CPOFUEL                                                                                                              0055
MIX 1 'MIXTRXE    1'                                                                                                       0056
INST-BURN                                                                                                                  0057
MICRO ALL                                                                                                                  0058
ENDMIX ;                                                                                                                   0059
MACROFUEL2 MATEX := MACINI: MATEX MACRO MACROFUEL :: EDIT 0 ;                                                              0060
MACRO3 MATEX := NEWMAC: MATEX MACROFUEL2 DEVICE :: EDIT 0 ;                                                                0061
SYSTEM := TRIVAA: MACRO3 TRACK :: EDIT 0 ;                                                                                 0062
FLUX := FLUD: SYSTEM TRACK ::  EDIT 0 EXTE 100 1.E-6 ;                                                                     0063
POWER NEWFLUX := FLPOW: FMAP FLUX TRACK MATEX :: EDIT 2 PTOT 2061.4 ;                                                      0064
DETECT := DETECT: DETECT NEWFLUX TRACK GEOM :: EDIT 5 REF 0 TIME 0.25 SIMEX ;                                              0065
SYSTEM MATEX TRACK MACRO MACROFUEL MACROFUEL2 GEOM DETECT                                                                  0066
FMAP := DELETE: SYSTEM MATEX TRACK MACRO MACROFUEL MACROFUEL2 DETECT GEOM FMAP ;                                           0067
GREP: FLUX :: GETVAL "K-EFFECTIVE" 1 >>Keff<< ;                                                                            0068
                     ?           ?                                                                                      @{
ECHO "K-EFFECTIVE: " Keff ;                                                                                                0069
END: ;                                                                                                                     0070
QUIT .                                                                                                                     0071
 
